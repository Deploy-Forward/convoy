{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convoy-bot",
  "main": "workers-site.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "src/convoy/site",
    "binding": "ASSETS"
  },
  "vars": {
    // TREE PLACEHOLDER, not the live origin. Live Worker binding (probed
    // 2026-09-04) is MCP_ORIGIN=https://convoy.bot and the deployed stub does
    // not read it: /mcp is fetch(request) pass-through to tunnel convoy-bot
    // -> 127.0.0.1:8788 on the Windows origin. Do not wrangler-deploy this
    // placeholder over production. Operator runbook: docs/redeploy.md
    "MCP_ORIGIN": "https://mcp-origin.example"
  }
  // Route is configured in Cloudflare once the convoy.bot zone is attached.
  // Example:
  // "routes": [
  //   { "pattern": "convoy.bot/*", "custom_domain": true }
  // ]
}
