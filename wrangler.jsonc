{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convoy-bot",
  "main": "workers-site.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "src/convoy/site",
    "binding": "ASSETS",
    "config": {
      "run_worker_first": true,
      "html_handling": "none"
    }
  },
  "vars": {
    // convoy.bot GET requests are served by Assets at the apex route.
    // Non-GET /mcp* requests must proxy to www, which reaches the same
    // tunnel origin without re-entering this Worker route.
    "MCP_ORIGIN": "https://www.convoy.bot"
  },
  // This is a Route in front of an application origin, not a Custom Domain
  // where the Worker itself would replace that origin.
  "routes": [
    { "pattern": "convoy.bot/*", "zone_name": "convoy.bot" }
  ]
}
