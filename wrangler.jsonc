{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "convoy-bot",
  "main": "workers-site.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "src/convoy/site",
    "binding": "ASSETS"
  },
  "vars": {
    // A Worker Route fetch to the same hostname continues to the proxied DNS
    // origin: the convoy-bot Tunnel, whose ingress is 127.0.0.1:8788.
    "MCP_ORIGIN": "https://convoy.bot"
  },
  // This is a Route in front of an application origin, not a Custom Domain
  // where the Worker itself would replace that origin.
  "routes": [
    { "pattern": "convoy.bot/*", "zone_name": "convoy.bot" }
  ]
}
